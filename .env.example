# AgentRouter origin. Do not include /v1/responses.
UPSTREAM_URL=https://agentrouter.org

# Local listen port.
PORT=8080
LISTEN_ADDRESS=0.0.0.0

# Supported values: claude-code, codex
SPOOF_PROFILE=claude-code

# Optional inbound protection. Clients must send X-Proxy-Token when set.
PROXY_AUTH_TOKEN=

# Upstream and streaming timeouts (Go duration syntax: ms, s, m).
RESPONSE_HEADER_TIMEOUT=5m
SSE_IDLE_TIMEOUT=10m
WARMUP_INTERVAL=3m

# Transport retries. 5xx retries are disabled by default because they can
# duplicate a billed generation request.
MAX_RETRIES=2
RETRY_DELAY=1s
RETRY_ON_5XX=false

# Maximum inbound request and buffered converted response size (20 MiB).
MAX_BODY_BYTES=20971520
