# Default API upstream: origin or prefix, optionally ending in /v1.
# Do not include /responses or /chat/completions. Stored keys override this URL.
UPSTREAM_URL=https://agentrouter.org
# Default/inbound protocol. Stored key protocols are configured in /admin.
UPSTREAM_API_PROTOCOL=responses
# Production: comma-separated allowed origins (scheme+host+port, no paths).
# Empty preserves unrestricted access. Explicitly list local origins when needed.
# Also restrict network egress/DNS against metadata access and rebinding.
UPSTREAM_ALLOWED_ORIGINS=

# Local listen port.
PORT=8080
LISTEN_ADDRESS=0.0.0.0

# Supported values: claude-code, codex, generic. Custom origins default to generic.
SPOOF_PROFILE=claude-code

# Compatibility mode for IDEs that cannot assemble parallel streamed tools.
FORCE_SEQUENTIAL_TOOLS=true

# Strip Azure resource-bound state before direct /v1/responses requests.
STATELESS_RESPONSES=true

# Optional inbound protection. Clients must send X-Proxy-Token when set.
PROXY_AUTH_TOKEN=

# Web panel (/admin). Use long random values. If KEY_STORE_SECRET is omitted,
# ADMIN_TOKEN is also used as the encryption secret.
ADMIN_TOKEN=
# First browser login: Token tab -> set password; legacy account login is owner.
# Remembered HttpOnly sessions require persistent /data and HTTPS on hosted domains.
# Optional multi-admin RBAC JSON. Roles: admin, viewer. totp_secret is Base32.
ADMIN_ACCOUNTS_JSON=
KEY_STORE_SECRET=
KEY_STORE_PATH=/data/keys.json

# inbound-first: IDE key wins, pool is fallback when missing.
# pool-first: stored key wins, inbound key is fallback.
# pool-only: always use an enabled stored key.
KEY_SELECTION_MODE=inbound-first
KEY_FAILOVER=true
KEY_COOLDOWN=5m
KEY_HEALTH_INTERVAL=5m

# Providers, explicit model routing and API-key provider references are managed
# in /admin (Providers and API keys). See docs/providers.md.
# HTTP/HTTPS/SOCKS5 network proxies and encrypted auth are managed in /admin.
# Adding the first proxy activates automatic bindings and disables inbound fallback.
# Explicit Direct keys ignore environment proxies. See docs/network-proxies.md.

# Optional v3 infrastructure.
STORAGE_BACKEND=file
DATABASE_URL=
REDIS_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN=5m

# Upstream and streaming timeouts (Go duration syntax: ms, s, m).
RESPONSE_HEADER_TIMEOUT=5m
SSE_IDLE_TIMEOUT=10m
WARMUP_INTERVAL=3m

# Transport retries: GET/HEAD by default. Ambiguous POST may already be accepted.
# Explicit unsafe/5xx retries can duplicate billed generation requests.
RETRY_UNSAFE_REQUESTS=false
MAX_RETRIES=2
RETRY_DELAY=1s
RETRY_ON_5XX=false

# Maximum inbound request and buffered converted response size (20 MiB).
MAX_BODY_BYTES=20971520
